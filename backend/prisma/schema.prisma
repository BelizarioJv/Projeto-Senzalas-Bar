generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//Enus para assegurar e garabtir a integridade dos dados 
enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum MovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum UnitMeasure {
  UNIT
  KG
  LITER
  FARDO
}

//Entidade (1:N(vendas)) "fornecedor" dados : id ,  nome , email , phone , address, cnpj , observaçoes , as compras feitas com o fornecedor ,data de criaçao e atualizaçao do fornecedor
model Supplier {
  id           Int        @id @default(autoincrement())
  name         String
  email        String?
  phone        String?
  address      String?
  cnpj         String?  @unique
  observations String?
  purchases    Purchase[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

//Entidade "Categorias" (1:N(Produtos))dados : nome e os produtos que contem a categoria
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]

  
}

//Entidade "Product" (1:N(compras e vendas) 1:1(categ) dados : id, nome , descriçao ,categoria , marca , unidade de medida , preço de custo e de venda , status e data de criaçao e venda)
model Product {
  id              Int              @id @default(autoincrement())
  name            String           
  description     String?
  categoryId      Int
  brand           String?
  unitMeasure     UnitMeasure
  costPrice       Decimal          @db.Decimal(10, 2)
  salePrice       Decimal          @db.Decimal(10, 2)
  currentQuantity Int               @default(0)
  minimumQuantity Int               @default(0)
  status          ProductStatus    @default(ACTIVE)
  category        Category         @relation(fields: [categoryId], references: [id])
  purchaseItems   PurchaseProduct[]
  saleItems       SaleItem[]
  stockMovements  StockMovement[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([categoryId])
}


//Entidade "movimentaçao de estoque" (1:N(Produtos) dados :id , produtos , tipo de movimentaçao , quantidade de produtos , e observaçoes )
model StockMovement {
  id              Int            @id @default(autoincrement())
  productId       Int
  movementType    MovementType
  quantity        Int
  observations    String?
  product         Product        @relation(fields: [productId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([productId])
}

//Entidade "Compra" (1:N(produtos) dados: id, data , total , fornecedor , status , metodo de pagamento ) 
model Purchase {
  id            Int              @id @default(autoincrement())
  date          DateTime         @default(now())
  total         Decimal          @db.Decimal(10, 2)
  supplierId    Int
  status        PurchaseStatus   @default(PENDING)
  payment       PaymentMethod?
  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  items         PurchaseProduct[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt


  @@index([supplierId])
}

//Entidade "Produtos da compra" (N:N(compra e produtos) dados: id , id da compra , id do produto ,quantidade do produto , preço do produto e subtotal)
model PurchaseProduct {
  id            Int        @id @default(autoincrement())
  purchaseId    Int
  productId     Int
  quantity      Int
  price         Decimal    @db.Decimal(10, 2)
  subtotal      Decimal    @db.Decimal(10, 2)
  purchase      Purchase   @relation(fields: [purchaseId], references: [id])
  product       Product    @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@unique([purchaseId, productId])
}

//Entidade "Venda" (1:N( com itens da venda)) dados : id, data/hora da venda, total, forma de pagamento, desconto, observação, itens da venda, data de criação e atualização
model Sale {
  id            Int              @id @default(autoincrement())
  dateTime      DateTime         @default(now())
  total         Decimal          @db.Decimal(10, 2)
  payment       PaymentMethod
  discount      Decimal?         @db.Decimal(10, 2)
  observation   String?
  items         SaleItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

//Entidade "Itens da venda" (N:N entre venda e produtos) dados : id, id da venda, id do produto, quantidade, preço unitário, subtotal
model SaleItem {
  id            Int        @id @default(autoincrement())
  saleId        Int
  productId     Int
  quantity      Int
  price         Decimal    @db.Decimal(10, 2)
  subtotal      Decimal    @db.Decimal(10, 2)

  sale          Sale       @relation(fields: [saleId], references: [id])
  product       Product    @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@unique([saleId, productId])
}