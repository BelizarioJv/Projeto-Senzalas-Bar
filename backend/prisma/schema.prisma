generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


//Enus para assegurar e garantir a integridade dos dados 
enum ProductStatus {
  ATIVO
  INATIVO
}


//Enum para categoria do produto
enum ProductsCategory{
  CERVEJA
  VINHOS
  DESTILADOS
  REFRIGERANTES
  SUCO
  AGUA
}

//Tipos de movimentaçoes
enum MovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

//Tipode de pagamento
enum PaymentMethod {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  FIADO
}


//Unidade de medida
enum UnitMeasure {
  UNIDADE
  KG
  LITRO
  FARDO
}
//Entidade (1:N(vendas e produtos) use dados : id , nome , usuario , password)
model User {
  id        Int      @id @default(autoincrement())
  name      String?
  user      String   @unique
  password  String
  createdAt DateTime @default(now())

  // Relacionamentos
  sale         Sale[]
  purchases    Purchase[]
  product      Product[]
}

//Entidade (1:N(vendas)) "cliente" dados : id , nome , telefone , email , saldo devedor , data de criaçao e atualizaçao do cliente
model Customer {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String?
  email        String?
  debtBalance  Decimal  @default(0.00) @db.Decimal(10, 2) 
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relacionamentos
  sales        Sale[]
}

//Entidade (1:N(vendas)) "fornecedor" dados : id ,  nome , email , phone , address, cnpj , observaçoes , as compras feitas com o fornecedor ,data de criaçao e atualizaçao do fornecedor
model Supplier {
  id           Int        @id @default(autoincrement())
  name         String
  email        String?
  phone        String?
  address      String?
  cnpj         String?  @unique
  observations String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  //Relacionamentos
  purchases    Purchase[]
}

//Entidade "Product" (1:N(compras e vendas) 1:1(categ) dados : id, nome , descriçao ,categoria , marca , unidade de medida , preço de custo e de venda , status e data de criaçao e venda)
model Product {
  id              Int              @id @default(autoincrement())
  name            String           
  description     String?
  brand           String?
  unitMeasure     UnitMeasure
  costPrice       Decimal          @db.Decimal(10, 2)
  salePrice       Decimal          @db.Decimal(10, 2)
  currentQuantity Int               @default(0)
  minimumQuantity Int               @default(0)
  status          ProductStatus    @default(ATIVO)
  category        ProductsCategory  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       Int?
  
  //Relacionamentos
  purchaseProducts   PurchaseProduct[]
  saleProducts       SaleProducts[]
  stockMovements  StockMovement[]
  usuario   User?   @relation(fields: [createdBy], references: [id])

}


//Entidade "Compra" (1:N(produtos) dados: id, data , total , fornecedor , status , metodo de pagamento ) 
model Purchase {
  id            Int              @id @default(autoincrement())
  date          DateTime         @default(now())
  total         Decimal          @db.Decimal(10, 2)
  supplierId    Int
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  userId        Int
  payment       PaymentMethod?
  
  //Relacionamentos
  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  products      PurchaseProduct[]
  stockMovements StockMovement[]
  user      User?      @relation(fields: [userId], references: [id])


  @@index([supplierId])
}


//Entidade "Produtos da compra" (N:N(compra e produtos) dados: id , id da compra , id do produto ,quantidade do produto , preço do produto e subtotal)
model PurchaseProduct {
  id            Int        @id @default(autoincrement())
  purchaseId    Int
  productId     Int
  quantity      Int
  price         Decimal    @db.Decimal(10, 2)
  subtotal      Decimal    @db.Decimal(10, 2)

  //Relacionamentos
  purchase      Purchase   @relation(fields: [purchaseId], references: [id])
  product       Product    @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@unique([purchaseId, productId])
}

//Entidade "Venda" (1:N( com itens da venda)) dados : id, data/hora da venda, total, forma de pagamento, desconto, observação, itens da venda, data de criação e atualização
model Sale {
  id            Int              @id @default(autoincrement())
  dateTime      DateTime         @default(now())
  total         Decimal          @db.Decimal(10, 2)
  discountPercent Float 
  discountValue   Float
  payment       PaymentMethod
  discount      Decimal?         @db.Decimal(10, 2)
  observation   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  userId        Int
  customerId    Int?


  //Relacionamentos
  products      SaleProducts[]
  stockMovements StockMovement[]
  user      User?      @relation(fields: [userId], references: [id])
  customer        Customer?     @relation(fields: [customerId], references: [id])
}

//Entidade "Itens da venda" (N:N entre venda e produtos) dados : id, id da venda, id do produto, quantidade, preço unitário, subtotal
model SaleProducts {
  id            Int        @id @default(autoincrement())
  saleId        Int
  productId     Int
  quantity      Int
  price         Decimal    @db.Decimal(10, 2)
  subtotal      Decimal    @db.Decimal(10, 2)

  //Relacionamentos
  sale          Sale       @relation(fields: [saleId], references: [id])
  product       Product    @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@unique([saleId, productId])
}

//Entidade "movimentaçao de estoque" (1:N(Produtos) dados :id , produtos , tipo de movimentaçao , quantidade de produtos , e observaçoes )
model StockMovement {
  id            Int @id @default(autoincrement())
  productId     Int
  purchaseId    Int?
  saleId        Int?
  movementType  MovementType
  quantity      Int
  observations  String?
  createdAt      DateTime @default(now())

  //Relacionamentos
  product Product @relation(fields: [productId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])
  sale Sale? @relation(fields: [saleId], references: [id])


  @@index([productId])
  @@index([purchaseId])
  @@index([saleId])
}